{
  "name": "code-dictator",
  "displayName": "Code Dictator",
  "description": "Voice dictation for VS Code — speak instead of typing prompts. Press Alt+D, talk, and paste into Claude, Copilot, Cursor, or any AI chat. Zero dependencies, 37 languages.",
  "version": "1.1.13",
  "publisher": "irrationalways",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Chat",
    "Other"
  ],
  "keywords": [
    "voice",
    "dictation",
    "speech-to-text",
    "voice coding",
    "push-to-talk",
    "whisper",
    "transcription",
    "microphone",
    "hands-free",
    "accessibility",
    "claude",
    "copilot",
    "cursor",
    "windsurf",
    "cline"
  ],
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dmitriusan/code-dictator"
  },
  "bugs": {
    "url": "https://github.com/Dmitriusan/code-dictator/issues"
  },
  "homepage": "https://irrationalways.com",
  "badges": [
    {
      "url": "https://img.shields.io/badge/platform-macOS%20%7C%20Linux%20%7C%20Windows-forestgreen",
      "href": "https://marketplace.visualstudio.com/items?itemName=irrationalways.code-dictator",
      "description": "Supported platforms: macOS, Linux, Windows"
    }
  ],
  "sponsor": {
    "url": "https://buymeacoffee.com/dmitriusan"
  },
  "author": {
    "name": "Dmytro Lisnichenko",
    "url": "https://github.com/Dmitriusan"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeDictator.toggleRecording",
        "title": "Code Dictator: Toggle Voice Recording",
        "icon": "$(mic)"
      },
      {
        "command": "codeDictator.cancelRecording",
        "title": "Code Dictator: Cancel Recording"
      },
      {
        "command": "codeDictator.showHistory",
        "title": "Code Dictator: Show Transcription History",
        "icon": "$(history)"
      },
      {
        "command": "codeDictator.transcribeFile",
        "title": "Code Dictator: Transcribe Audio File",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codeDictator.showUsage",
        "title": "Code Dictator: Show Usage & Costs",
        "icon": "$(dashboard)"
      },
      {
        "command": "codeDictator.selectLanguage",
        "title": "Code Dictator: Select Language",
        "icon": "$(globe)"
      },
      {
        "command": "codeDictator.openSettings",
        "title": "Code Dictator: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "codeDictator.setApiKey",
        "title": "Code Dictator: Set API Key"
      },
      {
        "command": "codeDictator.configureLanguages",
        "title": "Code Dictator: Configure Preferred Languages",
        "icon": "$(globe)"
      },
      {
        "command": "codeDictator.setCleanupApiKey",
        "title": "Code Dictator: Set OpenAI API Key (for LLM Cleanup)"
      }
    ],
    "keybindings": [
      {
        "command": "codeDictator.toggleRecording",
        "key": "alt+d",
        "mac": "alt+d"
      },
      {
        "command": "codeDictator.cancelRecording",
        "key": "escape",
        "mac": "escape",
        "when": "codeDictator.isRecording || codeDictator.isProcessing"
      }
    ],
    "configuration": [
      {
        "title": "Code Dictator: Speech Recognition",
        "properties": {
          "codeDictator.provider": {
            "order": 1,
            "type": "string",
            "default": "elevenlabs",
            "enum": [
              "elevenlabs",
              "openai",
              "custom"
            ],
            "enumDescriptions": [
              "ElevenLabs — High accuracy, 90+ languages (recommended)",
              "OpenAI — Great alternative if you already have an API key",
              "Custom Whisper-compatible API endpoint"
            ],
            "description": "Speech-to-text provider for voice transcription. After changing, you will be prompted for an API key on first recording."
          },
          "codeDictator.voiceModel": {
            "order": 2,
            "type": "string",
            "default": "auto",
            "enum": [
              "auto",
              "scribe_v2",
              "scribe_v1",
              "whisper-1",
              "gpt-4o-transcribe",
              "gpt-4o-mini-transcribe"
            ],
            "enumItemLabels": [
              "Auto (recommended)",
              "Scribe v2 (ElevenLabs)",
              "Scribe v1 (ElevenLabs)",
              "Whisper (OpenAI)",
              "GPT-4o Transcribe (OpenAI)",
              "GPT-4o Mini Transcribe (OpenAI)"
            ],
            "enumDescriptions": [
              "Automatically uses the best model for your selected provider",
              "ElevenLabs' latest model — best accuracy, 90+ languages",
              "ElevenLabs' previous generation model",
              "OpenAI's original Whisper model — good accuracy, 57 languages",
              "OpenAI's newest transcription model — higher accuracy, powered by GPT-4o",
              "OpenAI's efficient transcription model — good balance of speed and cost"
            ],
            "description": "Speech-to-text model. \"Auto\" selects the best model for your provider."
          },
          "codeDictator.customApiUrl": {
            "order": 3,
            "type": "string",
            "default": "",
            "description": "Custom speech-to-text API endpoint URL. Only used when Provider is set to \"Custom\" (e.g., http://localhost:8000/v1/audio/transcriptions)"
          },
          "codeDictator.language": {
            "order": 4,
            "type": "string",
            "default": "",
            "enum": [
              "",
              "en",
              "es",
              "fr",
              "de",
              "pt",
              "zh",
              "ja",
              "ko",
              "ru",
              "uk",
              "pl",
              "hi",
              "ar",
              "tr",
              "it",
              "nl",
              "sv",
              "da",
              "fi",
              "no",
              "cs",
              "ro",
              "hu",
              "el",
              "he",
              "th",
              "vi",
              "id",
              "ms",
              "bg",
              "hr",
              "sk",
              "sl",
              "sr",
              "ca",
              "ta",
              "bn"
            ],
            "enumItemLabels": [
              "Auto-detect",
              "English",
              "Spanish",
              "French",
              "German",
              "Portuguese",
              "Chinese",
              "Japanese",
              "Korean",
              "Russian",
              "Ukrainian",
              "Polish",
              "Hindi",
              "Arabic",
              "Turkish",
              "Italian",
              "Dutch",
              "Swedish",
              "Danish",
              "Finnish",
              "Norwegian",
              "Czech",
              "Romanian",
              "Hungarian",
              "Greek",
              "Hebrew",
              "Thai",
              "Vietnamese",
              "Indonesian",
              "Malay",
              "Bulgarian",
              "Croatian",
              "Slovak",
              "Slovenian",
              "Serbian",
              "Catalan",
              "Tamil",
              "Bengali"
            ],
            "markdownDescription": "Transcription language. Leave as Auto-detect for automatic language detection.\n\n_**Tip:** If your transcriptions come back in the wrong language (e.g., you speak English but get Polish text), set this to your spoken language explicitly. Auto-detect can misidentify languages, especially for multilingual speakers. Use `Code Dictator: Select Language` to quick-switch between languages._"
          },
          "codeDictator.preferredLanguages": {
            "order": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "en",
                "es",
                "fr",
                "de",
                "pt",
                "zh",
                "ja",
                "ko",
                "ru",
                "uk",
                "pl",
                "hi",
                "ar",
                "tr",
                "it",
                "nl",
                "sv",
                "da",
                "fi",
                "no",
                "cs",
                "ro",
                "hu",
                "el",
                "he",
                "th",
                "vi",
                "id",
                "ms",
                "bg",
                "hr",
                "sk",
                "sl",
                "sr",
                "ca",
                "ta",
                "bn"
              ],
              "enumItemLabels": [
                "English",
                "Spanish",
                "French",
                "German",
                "Portuguese",
                "Chinese",
                "Japanese",
                "Korean",
                "Russian",
                "Ukrainian",
                "Polish",
                "Hindi",
                "Arabic",
                "Turkish",
                "Italian",
                "Dutch",
                "Swedish",
                "Danish",
                "Finnish",
                "Norwegian",
                "Czech",
                "Romanian",
                "Hungarian",
                "Greek",
                "Hebrew",
                "Thai",
                "Vietnamese",
                "Indonesian",
                "Malay",
                "Bulgarian",
                "Croatian",
                "Slovak",
                "Slovenian",
                "Serbian",
                "Catalan",
                "Tamil",
                "Bengali"
              ]
            },
            "default": [],
            "description": "Your preferred languages for quick switching. Only these appear in the language picker. Also used as a language hint for AI text cleanup when language auto-detect is on. Use \"Code Dictator: Configure Languages\" command for a visual picker.",
            "uniqueItems": true
          }
        }
      },
      {
        "title": "Code Dictator: Text Processing",
        "properties": {
          "codeDictator.textProcessing.fillerRemoval": {
            "order": 1,
            "type": "boolean",
            "default": true,
            "markdownDescription": "Remove filler words (uh, um, like, äh, ну, えーと, etc.) from transcriptions. Covers 90+ languages, no API needed. Disable if filler removal interferes with your language or use case."
          },
          "codeDictator.textProcessing.codeAware": {
            "order": 2,
            "type": "boolean",
            "default": true,
            "description": "Convert spoken code terms to symbols (e.g., 'open paren' → '(')"
          },
          "codeDictator.textProcessing.aiCleanup": {
            "order": 3,
            "type": "boolean",
            "default": false,
            "markdownDescription": "**Highly recommended** — significantly improves transcription quality. After speech-to-text, sends the transcript through an OpenAI LLM to clean it up (rephrase, fix grammar, remove context-sensitive fillers). **Requires an OpenAI API key** — [Set OpenAI API Key](command:codeDictator.setCleanupApiKey)."
          },
          "codeDictator.textProcessing.aiModel": {
            "order": 4,
            "type": "string",
            "default": "gpt-4.1-mini",
            "enum": [
              "gpt-4.1-nano",
              "gpt-4.1-mini",
              "gpt-4.1"
            ],
            "enumItemLabels": [
              "Fast & Very Cheap",
              "Balanced",
              "Best Quality"
            ],
            "enumDescriptions": [
              "gpt-4.1-nano — cheapest and fastest, good for basic cleanup",
              "gpt-4.1-mini — better grammar and rephrasing, slightly higher cost",
              "gpt-4.1 — most accurate cleanup, highest cost"
            ],
            "markdownDescription": "OpenAI model for AI text cleanup. Smaller models are cheaper and faster; larger models produce better results."
          }
        }
      },
      {
        "title": "Code Dictator: Recording",
        "properties": {
          "codeDictator.recording.mode": {
            "order": 1,
            "type": "string",
            "default": "toggle",
            "enum": [
              "toggle",
              "hold"
            ],
            "enumDescriptions": [
              "Press Alt+D once to start recording, press Alt+D again to stop and transcribe",
              "Hold Alt+D to record — release the key to stop and transcribe automatically"
            ],
            "description": "Recording activation mode"
          },
          "codeDictator.recording.audioIsolation": {
            "order": 2,
            "type": "string",
            "default": "basic",
            "enum": [
              "off",
              "basic",
              "aggressive"
            ],
            "enumDescriptions": [
              "No noise reduction — raw audio",
              "Browser-native noise suppression and echo cancellation",
              "Additional filtering (high-pass, low-pass, compressor)"
            ],
            "description": "Audio noise reduction level"
          },
          "codeDictator.recording.silenceTimeout": {
            "order": 3,
            "type": "number",
            "default": 0,
            "minimum": 0,
            "maximum": 60,
            "markdownDescription": "Auto-stop recording after N seconds of silence (0 = disabled).\n\n*Note: Silence detection requires the webview-based recorder. On Linux systems using arecord as the native recorder, this setting has no effect — use `recording.maxDuration` instead.*\n\n*Silence detection may not work reliably in noisy environments or with background music — consider using `recording.maxDuration` as a fallback in those situations.*"
          },
          "codeDictator.recording.maxDuration": {
            "order": 4,
            "type": "number",
            "default": 300,
            "minimum": 10,
            "maximum": 3600,
            "description": "Maximum recording duration in seconds"
          }
        }
      },
      {
        "title": "Code Dictator: Output",
        "properties": {
          "codeDictator.output.target": {
            "order": 1,
            "type": "string",
            "default": "clipboard",
            "enum": [
              "clipboard",
              "editor"
            ],
            "enumDescriptions": [
              "Copy transcription to clipboard — paste wherever you need it",
              "Insert at cursor in active text editor (may not work with AI chat panels)"
            ],
            "description": "Where to send transcribed text"
          },
          "codeDictator.output.autoCopy": {
            "order": 2,
            "type": "boolean",
            "default": true,
            "description": "Also copy transcription to clipboard (in addition to primary target)"
          }
        }
      },
      {
        "title": "Code Dictator: Feedback",
        "properties": {
          "codeDictator.feedback.showCost": {
            "order": 1,
            "type": "boolean",
            "default": true,
            "description": "Show estimated cost in status bar"
          },
          "codeDictator.feedback.flashDuration": {
            "order": 2,
            "type": "number",
            "default": 5,
            "minimum": 1,
            "maximum": 30,
            "description": "How many seconds the success indicator stays visible after transcription completes"
          },
          "codeDictator.feedback.flashBackground": {
            "order": 3,
            "type": "boolean",
            "default": false,
            "description": "Use a solid background for the success indicator instead of colored text (exact color depends on your theme)"
          },
          "codeDictator.feedback.transcriptionSound": {
            "order": 4,
            "type": "boolean",
            "default": false,
            "description": "Play a short chime when transcription completes successfully"
          }
        }
      },
      {
        "title": "Code Dictator: Advanced",
        "properties": {
          "codeDictator.diagnosticLogging": {
            "order": 1,
            "type": "boolean",
            "default": false,
            "markdownDescription": "Log recording diagnostics to the **Code Dictator** output channel. Enable this if recordings stop unexpectedly or you need to troubleshoot microphone issues."
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "codeDictator.setup",
        "title": "Get Started with Code Dictator",
        "description": "Set up voice dictation for your AI coding assistant in 30 seconds",
        "steps": [
          {
            "id": "chooseProvider",
            "title": "Choose Your Provider",
            "description": "Select a speech-to-text provider. We recommend ElevenLabs for best accuracy.\n\n[Open Settings](command:codeDictator.openSettings)",
            "media": {
              "markdown": "resources/walkthrough/provider.md"
            }
          },
          {
            "id": "setApiKey",
            "title": "Set Your API Key",
            "description": "Enter your API key securely. It's stored in your OS keychain.\n\n[Set API Key](command:codeDictator.setApiKey)",
            "media": {
              "markdown": "resources/walkthrough/apikey.md"
            }
          },
          {
            "id": "tryRecording",
            "title": "Try Voice Recording",
            "description": "Press **Alt+D** or click the mic icon in the status bar to start recording.\n\n[Toggle Recording](command:codeDictator.toggleRecording)",
            "media": {
              "markdown": "resources/walkthrough/record.md"
            }
          },
          {
            "id": "customize",
            "title": "Customize",
            "description": "Set your preferred languages, recording mode, and more.\n\n[Open Settings](command:codeDictator.openSettings)",
            "media": {
              "markdown": "resources/walkthrough/customize.md"
            }
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codeDictator.cancelRecording",
          "when": "codeDictator.isRecording || codeDictator.isProcessing"
        }
      ]
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=es2022 --sourcemap",
    "compile:prod": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=es2022 --minify",
    "watch": "npm run compile -- --watch",
    "build": "npm run compile:prod",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsc -p tsconfig.e2e.json && node dist-test/runTests.js",
    "prepackage": "rm -f *.vsix",
    "package": "npm run build && vsce package",
    "prepublish": "npm run build",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
